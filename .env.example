# =============================================================
# pmotto — 環境変数テンプレート
#
# docker compose が参照する変数の一覧。値の渡し方は次のどちらでもよい。
#   - docker を起動するシェルで export する（このリポジトリの既定運用）
#   - このファイルを .env にコピーして書き換える（make env）
#
# 【設定方針】
# 設定するのは下の「部品」だけでよい。URL や DB 接続情報のような複合値は、
# docker-compose.yml 側で部品から自動的に組み立てられる。
# 例: API_PORT を 8082 に変えれば NUXT_PUBLIC_API_BASE も自動で 8082 を向く。
# 最下部の「上書き用」は、組み立て結果では足りない場合だけコメントを外す。
# =============================================================

# ---------------------------------------------------------------
# 部品 1 — 必須（デフォルト値なし）
#
# このセクションの3つが未設定だと、docker compose がコンテナを作る前に
# エラーで停止する（空パスワードの MySQL や空の署名鍵での起動を防ぐため）。
# 停止系のコマンドも同じ検証を通るため、docker を操作するシェルでは
# 常にこの3つが設定されている状態にしておく。
# ---------------------------------------------------------------

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=pmo_proto

# JWT 署名シークレット。本番では必ず変更する: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# ---------------------------------------------------------------
# 部品 2 — ホスト側に公開するポート（コンテナ内のポートは固定）
# ---------------------------------------------------------------

# API_PORT は「ホスト公開ポート」と「API がコンテナ内で listen するポート」の両方。
# config.go も同じ API_PORT を読むため、この1つを変えれば全体が追随する。
API_PORT=8080

PMO_DASHBOARD_PORT=3000

# n8n（Backlog連携・レポート自動生成）。API_PORT と同様、ホスト公開と
# コンテナ内 listen の両方を指す。
# 5679 は n8n 内部の Task Broker が使うため指定しないこと（起動に失敗する）。
N8N_PORT=5678

# ホスト側で別の MySQL が 3306 を使っている場合は 3307 などに変更する。
MYSQL_PORT=3306

# ---------------------------------------------------------------
# 部品 3 — ブラウザからアクセスするホスト名
# ---------------------------------------------------------------

# ローカル開発は localhost のまま。別マシンや LAN から開く場合に IP / ホスト名へ変える。
# APP_BASE_URL と NUXT_PUBLIC_API_BASE の組み立てに使われる。
APP_HOST=localhost

# ---------------------------------------------------------------
# 上書き用 — 通常は設定不要。組み立て結果を使いたくない場合のみ有効化する
# ---------------------------------------------------------------

# n8n のタイムゾーンとロケール。スケジュールトリガの発火時刻に効く。
#TZ=Asia/Tokyo
#N8N_DEFAULT_LOCALE=ja

# 認証Cookieの Secure 属性（既定 true）。HTTPのローカル開発でのみ false にする。
# ※ docker-compose.yml がローカル用に false を既定指定しているため通常は不要
#COOKIE_SECURE=false

# DB の接続先ホストとポートは設定項目ではない。compose ネットワーク内の
# mysql サービス（コンテナ内 3306）で固定のため、docker-compose.yml に直接書いている。
# MYSQL_PORT はホストへの公開ポートであり、API の接続先には使えないので注意。
#
# 以下は上書き可能。変数名が PMO_ で始まるのは意図的で、DB_USER のような一般的な名前は
# 他プロジェクト用にシェルへ export されていることがあり、その値を拾って
# 意図しない接続をしてしまう事故が起きるため（実際に DB_PORT=5433 で発生した）。
# コンテナ内でアプリが読む名前は DB_USER / DB_PASSWORD / DB_NAME のままなので、
# ここで DB_USER= を設定しても効かない。上書きするときは PMO_ 付きを使うこと。
#PMO_DB_USER=root

# 既定は上の MYSQL_ROOT_PASSWORD / MYSQL_DATABASE を流用する。
# アプリ専用ユーザーを切る場合などに指定する。
#PMO_DB_PASSWORD=
#PMO_DB_NAME=

# 既定は http://${APP_HOST}:${PMO_DASHBOARD_PORT} を組み立てる。
# リバースプロキシ配下など、ホスト名とポートの組み合わせで表せない場合に指定する。
#APP_BASE_URL=https://pmo.example.com

# 既定は http://${APP_HOST}:${API_PORT} を組み立てる。
#NUXT_PUBLIC_API_BASE=https://api.example.com

# SSR（コンテナ内）から API を叩くベースURL。compose ネットワーク内の通信で
# コンテナ内ポートは固定のため、ホスト側のポートを変えても変更不要。
#NUXT_API_BASE_SERVER=http://api:8080

# ---------------------------------------------------------------
# API のチューニング項目 — すべて省略可
#
# api/internal/config/config.go の getEnv* が既定値を持つため、compose からは
# 渡していない。既定を変えたいときだけ有効化する（コメント内の値が現在の既定）。
# ---------------------------------------------------------------

# DBコネクションプール。max_connections 枯渇と、wait_timeout 経過後の
# 死んだ接続の再利用を防ぐ。0 以上の整数で、不正値は起動時エラーになる。
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=25
#DB_CONN_MAX_LIFETIME=5m

# トークン有効期限（time.ParseDuration 形式）。
#ACCESS_TOKEN_TTL=8h
#REFRESH_TOKEN_TTL=168h
#SET_TOKEN_TTL=72h

# 認証系エンドポイントのレート制限（クライアントIPごと）。
# オンライン総当り・クレデンシャルスタッフィングの抑止用。
# 1 以上の整数で、0 以下は設定ミスとして起動時エラーになる。
#AUTH_RATE_LIMIT_PER_MIN=10
#AUTH_RATE_LIMIT_BURST=5
